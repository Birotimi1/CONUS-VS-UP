  "additional_check_source": "addpath(fullfile(pwd,'THBI')); a0_STARTUP_BAYES();\npar=bayes_inv_parms('extended100');\n[~,truth]=a2_LOAD_DATA(par,true); model=truth.zoned_parameters;\nreport=struct();\nreport.true_K=model.K;\nreport.true_shallow_interfaces_km=cumsum(model.matrix(1:4,1))';\nreport.min_thickness_at_truth_km=diff([0 model.zsed model.zmoh par.mod.maxz]).*par.mod.min_fraction;\nreport.interface_step_at_truth_km=diff([0 model.zsed model.zmoh par.mod.maxz]).*par.proposal.interface_step;\nrefined=refine_layer_model(model.matrix,2);\nreport.refined_truth_halfspace_top_km=sum(refined(:,1));\nassert(abs(report.refined_truth_halfspace_top_km-70)<1e-10);\nassert(isequal(report.true_K,[3 4 3]) && a1_TEST_CONDITIONS(model,par));\n% Current zone prior permits a crustal velocity reversal excluded by old HBI.\nreversal=model; reversal.crustmparm.VS=[2.8;3.8;3.6;3.98];\nreport.crustal_reversal_supported=a1_TEST_CONDITIONS(reversal,par);\nassert(report.crustal_reversal_supported);\n% Old gamma-density prior and eta proposal Jacobian vs current eta-density prior.\nbase=a3_CALC_LOG_PRIOR(model,par);\nfor eta=[-1 1]\n    trial=model; trial.datahparm.eta(1)=eta;\n    current_delta=a3_CALC_LOG_PRIOR(trial,par)-base;\n    old_delta=(-.5*(eta/2)^2-eta)+eta;\n    assert(abs(current_delta-old_delta)<1e-12);\nend\nreport.gamma_coordinate_equivalence=true;\n% A valid inverse split/merge need not preserve travel time or a data fit.\nh=model.matrix(1:2,1); v=model.matrix(1:2,3);\nvmerge=sum(h.*v)/sum(h);\nreport.first_pair_s_travel_seconds=sum(h./v);\nreport.merged_pair_s_travel_seconds=sum(h)/vmerge;\nreport.merged_pair_s_travel_fractional_change=report.merged_pair_s_travel_seconds/report.first_pair_s_travel_seconds-1;\nfor d=1:4\n    name=par.inv.datatypes{d};\n    if d==1, x=par.synth.grids.(name).f; else, x=par.synth.grids.(name).T; end\n    report.data_points.(name)=numel(x);\nend\nfor name={'rf','rf_sp'}\n    d=name{1}; cfg=par.forc.(d); w=par.synth.([d '_window']);\n    t=-cfg.delay+(0:cfg.npts-1)'*cfg.dt;\n    report.data_points.(d)=sum(t>=w(1)-2e-5 & t<=w(2)+2e-5);\nend\nreport.provenance='Solver-free source-comparison checks under Octave; no native forward model or inversion run.';\nfid=fopen('/private/tmp/conus_workflow_review_checks.json','w');\nfprintf(fid,'%s\\n',jsonencode(report)); fclose(fid);\ndisp(report);\n",
  "harness_corrections": [
    "Removed an incorrect output request from the void test_thbi_layered_dr function, then ran remaining tests successfully.",
